{
  "name": "crossref-mcp-server",
  "version": "2.0.2",
  "description": "MCP server: metadata and BibTeX for papers and books by DOI or arXiv id (Crossref, Semantic Scholar, arXiv, Open Library, ORCID)",
  "type": "module",
  "bin": {
    "crossref-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node build.mjs",
    "prepare": "node build.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p .",
    "test": "node tests/run.mjs",
    "sync-core": "node scripts/sync-core.mjs"
  },
  "author": "Alberto Mercurio",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "mathml-to-latex": "1.8.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.27.7",
    "typescript": "5.9.3"
  }
}
